# Generated securely by deploy.ps1 / deploy.sh. Never commit your .env.
WEB_PORT=4173
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_PASSWORD=
JWT_SECRET=
CREDENTIAL_MASTER_KEY=
RESET_ADMIN_PASSWORD=false
# 体验账号默认不创建；需要演示时显式设置至少 8 位、与管理员不同的密码。
# 留空只跳过新账号创建，不会禁用数据库中已有的账号；已有账号请在管理后台禁用。
BOOTSTRAP_TEST_USERNAME=test
BOOTSTRAP_TEST_PASSWORD=
RESET_TEST_PASSWORD=false
# Legacy comparison experiments are synthetic DEMO only. live/http shared-key calls are disabled.
MODEL_MODE=demo
# Remote calls require each user's own encrypted profile and explicit preview confirmation.
# Keep disabled until the deployment/operator is ready. This file does not enable any running service.
PERSONAL_AI_REMOTE_ENABLED=false
# Exact reviewed HTTPS API bases only; empty allows only documented built-in provider addresses.
PERSONAL_AI_ALLOWED_BASE_URLS=
# Literal addresses of proxies you operate; empty ignores forwarded headers (secure default).
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_AUTH=10

# Connection pools are per API/worker process; size to MySQL max_connections.
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
# Deployed startup should migrate once in the API; workers validate existing schema.
